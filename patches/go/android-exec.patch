 )
 
+// androidExecFallback (exec_android.go): start through the Android system linker —
+// with e == nil when direct starts are known to be denied, with e after a failed start.
+var androidExecFallback func(e error, name string, argv []string) (string, []string, bool)
+
 // The only signal values guaranteed to be present in the os package on all
 // systems are os.Interrupt (send the process an interrupt) and os.Kill (force
 // the process to exit). On Windows, sending os.Interrupt to a process with
@@ -52,7 +56,19 @@ func startProcess(name string, argv []string, attr *ProcAttr) (p *Process, err e
 		sysattr.Files = append(sysattr.Files, f.Fd())
 	}
 
-	pid, h, e := syscall.StartProcess(name, argv, sysattr)
+	execName, execArgv := name, argv
+	if androidExecFallback != nil {
+		// Android: once direct start was denied, go through the system linker at once
+		if lname, largv, ok := androidExecFallback(nil, name, argv); ok {
+			execName, execArgv = lname, largv
+		}
+	}
+	pid, h, e := syscall.StartProcess(execName, execArgv, sysattr)
+	if e != nil && androidExecFallback != nil && execName == name {
+		if lname, largv, ok := androidExecFallback(e, name, argv); ok {
+			pid, h, e = syscall.StartProcess(lname, largv, sysattr)
+		}
+	}
 
 	// Make sure we don't run the finalizers of attr.Files.
 	runtime.KeepAlive(attr)
